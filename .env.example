#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
.env.example - পরিবেশ ভেরিয়েবল টেমপ্লেট
এই ফাইলটি .env নামে কপি করুন এবং আপনার শংসাপত্র যোগ করুন
"""

# Quotex API Configuration
QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password
QUOTEX_API_KEY=your_api_key

# Trading Settings
TRADE_AMOUNT=10
CHECK_INTERVAL=60

# Risk Management
MAX_DAILY_LOSS=100
MAX_TRADES_PER_DAY=10

# Telegram Notifications
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SEND_NOTIFICATIONS=true

# Debug Mode
DEBUG=false
